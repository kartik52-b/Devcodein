# ---------------------------------------------------------------------------
# DevVerse — frontend environment (Vite)
#
# Copy this file to `.env.local` (never commit that file) and fill in the
# values from your Supabase project: Dashboard → Project Settings → API.
#
# Both values below are PUBLIC by design: they are compiled into the browser
# bundle. That is safe only because every table is protected by Row Level
# Security. Never put a service-role key in a VITE_* variable.
# ---------------------------------------------------------------------------

# REQUIRED for authentication on a Vercel/static deployment. Without both
# values the browser falls back to the Express API, which does not exist on
# Vercel — every /api/auth call would answer 404.
#
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key (NOT the service_role key)
VITE_SUPABASE_ANON_KEY=

# Optional: absolute URL of the Express API when it runs on another origin.
# Leave empty when the API is served from the same origin (Vite dev proxy) or
# when only Supabase is used.
# VITE_API_URL=http://localhost:5000
