PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devverse
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional: lets POST /api/auth/supabase verify Supabase access tokens so the
# Express API (problems, submissions, leaderboards) keeps working alongside
# Supabase authentication. Use the public anon key — never the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public origin(s) of the frontend, comma separated (used for CORS + OAuth).
CLIENT_URL=http://localhost:3000
